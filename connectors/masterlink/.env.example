# VPS1: connector MCP. Plik produkcyjny trzymaj poza repo i ustaw chmod 600.
# Bieżący profil VPS1 używa bezpośredniego HTTPS do API i lokalnego relay TCP do PostgreSQL.
# Relay nasłuchuje wyłącznie na 127.0.0.1; PostgreSQL nadal używa TLS i przypiętego CA Railway.

ML_API_BASE_URL=https://ml.paryskie.pl
ML_USERNAME=bok_agent_connector
ML_PASSWORD=

# Połączenie służy WYŁĄCZNIE do dokładnego rozwiązywania identyfikatorów.
# Connector wymusza BEGIN READ ONLY i statement_timeout. Docelowo użyj roli DB z SELECT-only.
ML_READ_DATABASE_URL=postgresql://masterlink_bok_ro:UZUPELNIJ@localhost:15432/railway
ML_DB_SSL=true
ML_DB_SSL_CA_FILE=/home/oliwer/workspace/paryskie-bok-agent/connectors/masterlink/config/railway-postgres-root-ca.pem

ML_TIMEOUT_MS=5000
ML_MAX_RESULTS=25
ML_AUDIT_PATH=/home/oliwer/.local/state/paryskie-bok-agent/masterlink-audit.jsonl
ML_IDEMPOTENCY_DB_PATH=/home/oliwer/.local/state/paryskie-bok-agent/idempotency.sqlite

# Osobny sekret (min. 32 losowe bajty) do HMAC identyfikatorów w audycie.
ML_AUDIT_HASH_KEY=

# Bezpieczny stan początkowy. Zmień na true dopiero po odbiorze dry-runów i kontrolowanym teście zapisu.
ML_MUTATIONS_ENABLED=false

# Gdy ustawiono ML_ENV_FILE, connector odmawia startu, jeśli plik nie ma trybu 600.
ML_REQUIRE_ENV_FILE_MODE_600=true
