# Token technicznego bota Discord. To nie jest klucz do modelu.
DISCORD_BOT_TOKEN=

# Kanały, na których agent odpowiada na każdą wiadomość dozwolonego użytkownika.
BOK_AGENT_COMMAND_CHANNEL_IDS=

# Kanały czytane jako kontekst; agent odpowiada tam tylko po wzmiance.
BOK_AGENT_OBSERVE_CHANNEL_IDS=

# Użytkownicy lub role zespołu, z którymi agent prowadzi rozmowę i od których uczy się korekt.
# W produkcji preferuj rolę BOK, a indywidualne ID zostaw jako awaryjną allowlistę właściciela.
BOK_AGENT_ALLOWED_USER_IDS=
BOK_AGENT_ALLOWED_ROLE_IDS=
# Osobna, jawna lista użytkowników uprawnionych do decyzji Gotowe/Do poprawy.
# Pusta lista blokuje wszystkie decyzje o draftach.
BOK_AGENT_APPROVER_USER_IDS=

# Ochronny default. W produkcji pozostaw false, dopóki każdy connector zapisu nie ma stabilnego
# klucza idempotencji i potwierdzonego readbacku. Samo true nie odblokowuje wysyłki reply_customer.
BOK_AGENT_EXTERNAL_ACTIONS=false
# Niezależna brama wyłącznie dla inspekcji już otwartych stron w zalogowanym Chrome.
# Techniczna allowlista nie zawiera nawigacji, kliknięć, formularzy, JS, sieci ani konsoli.
BOK_AGENT_BROWSER_RESEARCH=false
BOK_AGENT_MODEL=
BOK_AGENT_REASONING_EFFORT=medium
BOK_AGENT_WORKSPACE=./agent-workspace
BOK_AGENT_STATE_DIR=./state
BOK_AGENT_MAX_CONTEXT_MESSAGES=30
BOK_AGENT_MAX_SHARED_CONTEXT_MESSAGES=60
BOK_AGENT_DISCORD_BACKFILL_MESSAGES=50

# PII-free raport zbiorczy MasterLink. Token przechowuj wyłącznie w chronionym pliku ENV.
MASTERLINK_REPORT_URL=
MASTERLINK_REPORT_TOKEN=
MASTERLINK_REPORT_TIMEOUT_MS=15000

# Bezpośredni connector MasterLink MCP. Włącz dopiero po zielonym smoke teście tunelu/API/DB.
MASTERLINK_MCP_ENABLED=false
MASTERLINK_MCP_PROJECT_DIR=./connectors/masterlink
# Pusta wartość używa ~/.config/paryskie-bok-agent/masterlink.env.
MASTERLINK_MCP_ENV_FILE=

# Automatyczny monitor otwartych ticketów przez zalogowany Chrome Agent.
DAKTELA_MONITOR_ENABLED=false
DAKTELA_VIEW_URL=https://pariscosmetics.daktela.com/tickets/
DAKTELA_BROWSER_CDP_URL=http://127.0.0.1:9333
DAKTELA_ESCALATION_CHANNEL_ID=
DAKTELA_POLL_INTERVAL_MS=120000
DAKTELA_MAX_TICKETS_PER_SCAN=1

# Prywatny, stateless port inferencji dla natywnego BOK MasterLink.
# Serwer zawsze akceptuje wyłącznie jawny loopback; TLS kończy prywatny reverse proxy/tunel.
BOK_NATIVE_API_HOST=127.0.0.1
BOK_NATIVE_API_PORT=8787
BOK_NATIVE_API_TOKEN=
BOK_NATIVE_API_MAX_CONCURRENCY=2
# Musi być krótszy lub równy timeoutowi klienta w MasterLink (maks. 120 s).
BOK_NATIVE_API_TIMEOUT_MS=110000
# Puste = BOK_AGENT_MODEL, a gdy on też jest pusty: stabilne codex-subscription-managed.
BOK_NATIVE_API_GENERATOR_MODEL=
BOK_NATIVE_API_JUDGE_MODEL=
# Osobny katalog logowania Codexa; nie ustawiaj tu głównego ~/.codex i nie kopiuj jego config.toml.
BOK_NATIVE_CODEX_HOME=/home/oliwer/.codex-native-bok
